# Copie para .env e informe a senha definida no Neo4j Desktop.
# Nunca compartilhe nem versione o arquivo .env.
NEO4J_USER=neo4j
NEO4J_PASSWORD=ALTERE_PARA_SUA_SENHA_DO_NEO4J
GRAPH_DATABASE=neo4j
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
EMBEDDING_CACHE_DIR=/app/data/embedding_models
EMBEDDING_THREADS=2
CHUNK_FULLTEXT_INDEX=chunk_fulltext
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=15
